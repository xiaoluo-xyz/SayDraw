{
  "name": "saydraw",
  "version": "0.6.0",
  "description": "AIImage - 对话式图片创作 Agent(Windows 桌面端)",
  "main": "./out/main/index.js",
  "author": "AIImage",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "verify:image": "node --no-warnings --experimental-strip-types scripts/verify-image-fallback.mjs",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "verify:composite": "node --no-warnings --experimental-strip-types scripts/verify-composite.mjs",
    "verify:fidelity": "node --no-warnings scripts/verify-fidelity.mjs",
    "verify:fidelity:live": "electron scripts/verify-fidelity-live.cjs",
    "verify:hardcases": "electron scripts/verify-hardcases-live.cjs all",
    "verify:composite:live": "electron scripts/verify-composite-live.cjs",
    "verify:workspaces": "node --no-warnings --experimental-strip-types scripts/verify-workspaces.mjs",
    "verify:recovery": "node --no-warnings scripts/verify-recovery.mjs",
    "verify:recovery:live": "node --no-warnings scripts/verify-recovery-live.mjs"
  },
  "dependencies": {
    "konva": "^10.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.0.0"
  }
}
